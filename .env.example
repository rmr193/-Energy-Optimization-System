# ==============================================================================
# GridWise — Environment Configuration
# BUP CSE Fest 2026 Hackathon (Online Preliminary)
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Provider Configuration
# Supported: "gemini", "openai", "local_fallback"
LLM_PROVIDER=gemini

# Google Gemini API Key (if LLM_PROVIDER=gemini)
# Model options: "gemini-2.5-flash", "gemini-1.5-flash"
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# OpenAI API Key (if LLM_PROVIDER=openai)
# Model options: "gpt-4o-mini", "gpt-4o"
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local fallback configuration:
# When no API key is supplied or LLM API is unavailable, the service automatically
# uses the deterministic local semantic engine so the service never fails or crashes.
ENABLE_LOCAL_FALLBACK=true
